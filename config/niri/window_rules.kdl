// Window rules and Layout
workspace "codespace" {
    open-on-output "HDMI-A-1"
}
workspace "browser" {
    open-on-output "HDMI-A-1"
}
workspace "communication" {
    open-on-output "HDMI-A-1"
}

workspace "stash" {
    open-on-output "HDMI-A-1"
}

window-rule {
    match app-id=r#"^(kitty|google-chrome(-stable)?)$"#
    match app-id=r#"^(codex-desktop|com.anthropic.Claude|discord|slack)$"#
    default-column-width { proportion 1.0; }
}

// Chrome print dialog.
window-rule {
    match app-id=r#"^google-chrome(-stable)?$"# title="^Print$"
    open-floating true
    default-column-width { proportion 0.7; }
}

// Keep a minimal visible indicator without showing Meet's status popup.
window-rule {
    match app-id="^$" title=r#"^meet\.google\.com is sharing your screen\.$"#
    open-focused false
    default-floating-position x=-2000 y=2000 relative-to="top-left"
    focus-ring {
        on
        width 0
    }
}

window-rule {
    geometry-corner-radius 4
    clip-to-geometry true
}

layout {
    gaps 4
    center-focused-column "never"
    preset-column-widths {
        proportion 0.4
        proportion 0.6
        proportion 1.0
    }
    default-column-width {
        proportion 0.6
    }
    focus-ring {
        width 3
        active-color "#74c7ec"
        inactive-color "#505050"
        active-gradient from="#80c8ff" to="#bbddaa" angle=45
    }
    // You can also add a border. It's similar to the focus ring, but always visible.
    border {
        off
        width 3
        urgent-color "#9b0000"
        active-gradient from="#f38ba8" to="#f9e2af" angle=45 relative-to="workspace-view"
        inactive-gradient from="#585b70" to="#7f849c" angle=45 relative-to="workspace-view"
    }
}
